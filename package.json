{
  "name": "@victortolbert/preflight",
  "type": "module",
  "version": "0.3.1",
  "private": false,
  "packageManager": "pnpm@11.20.0",
  "description": "The foundational project-setup layer — the safeguards a project should have before feature work begins.",
  "author": "Victor Tolbert",
  "license": "MIT",
  "keywords": [
    "commitlint",
    "config",
    "configuration",
    "drift",
    "preset",
    "scaffold",
    "taze",
    "skills-npm"
  ],
  "homepage": "https://github.com/victortolbert/preflight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victortolbert/preflight.git"
  },
  "bugs": "https://github.com/victortolbert/preflight/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "preflight": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./commitlint": "./dist/presets/commitlint.mjs",
    "./markdownlint": "./presets/markdownlint.json",
    "./security-headers": "./dist/presets/security-headers.mjs",
    "./taze": "./dist/presets/taze.mjs",
    "./vue-a11y": "./dist/presets/vue-a11y.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "presets",
    "templates"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:packaging": "publint --strict && attw --pack . --profile esm-only",
    "release": "bumpp",
    "pretest": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=21",
    "taze": ">=19"
  },
  "peerDependenciesMeta": {
    "@commitlint/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/lint": "^21.2.0",
    "@commitlint/load": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^24.10.1",
    "bumpp": "^12.1.1",
    "es-module-lexer": "^2.3.1",
    "publint": "^0.3.14",
    "taze": "19.17.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@commitlint/config-conventional": "^21.2.0",
    "cac": "^7.0.0",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "unconfig": "^7.5.0"
  }
}
